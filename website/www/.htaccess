
RewriteEngine On

<IfModule mod_negotiation.c>
    Options -MultiViews
</IfModule>

# TODO: Pas nodig als de website eenmaal live gaat 
# (Anders kan je niet met andere apparaten erop)
# RewriteCond %{HTTP_HOST} ^www\.(.*)$ [NC]
# RewriteRule ^ %{REQUEST_SCHEME}://%1%{REQUEST_URI} [R=301,L]

# RewriteCond %{HTTPS} off
# RewriteCond %{HTTP_HOST} !=localhost
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301] 

# Authentication links
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/src/
RewriteRule ^(.*)auth/verify$ $1/src/auth/verify [QSA,DPI]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/src/
RewriteRule ^(.*)auth/reset$ $1/src/auth/reset [QSA,DPI]

# Member pages
RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/src/
RewriteRule ^(.*)member$ $1/src/user/member [QSA,DPI]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/src/
RewriteRule ^(.*)moderator$ $1/src/user/moderator [QSA,DPI]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/src/
RewriteRule ^(.*)admin$ $1/src/user/admin [QSA,DPI]

RewriteCond %{REQUEST_URI} !^/api/
RewriteCond %{REQUEST_URI} !^/src/
RewriteRule ^(.*)owner$ $1/src/user/owner [QSA,DPI]

# Making sure things are redirected to the correct file types
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.html -f
RewriteRule ^(.*)$ $1.html

RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.htm -f
RewriteRule ^(.*)$ $1.htm